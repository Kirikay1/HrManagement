<Page x:Class="HrManagement.Views.HrManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#77B34B"/>
        <SolidColorBrush x:Key="HeaderGreenBrush" Color="#EAF8DF"/>
        <SolidColorBrush x:Key="CardGreenBrush" Color="#E6F5C9"/>
        <SolidColorBrush x:Key="PanelGrayBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#D0D0D0"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGreenBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="70" Height="70" Background="{StaticResource AccentGreenBrush}" CornerRadius="40" Margin="12,0">
                    <TextBlock Text="логотип" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="10" Height="40" VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="Организационная структура" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="640"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelGrayBrush}" Padding="18" Margin="0,0,12,0">
                <Canvas x:Name="canvasOrgChart" MinHeight="560" MinWidth="690">
                    <Button x:Name="nodeTop" Content="Дороги России" Click="FilterByDepartment_Click" Canvas.Left="300" Canvas.Top="8"/>
                    <Button x:Name="nodeLeftDept" Content="Административный департамент" Click="FilterByDepartment_Click" Canvas.Left="140" Canvas.Top="60"/>
                    <Button x:Name="nodeRightDept" Content="Академия Умные дороги" Click="FilterByDepartment_Click" Canvas.Left="380" Canvas.Top="60" Width="180"/>
                    <Button x:Name="nodeContract" Content="Договорной отдел" Click="FilterByDepartment_Click" Canvas.Left="30" Canvas.Top="120" Width="160"/>
                    <Button x:Name="nodeCommon" Content="Общий отдел" Click="FilterByDepartment_Click" Canvas.Left="250" Canvas.Top="120" Width="180"/>
                    <Button x:Name="nodeMarketing" Content="Управление маркетинга" Click="FilterByDepartment_Click" Canvas.Left="380" Canvas.Top="180" Width="180"/>
                    <Button x:Name="nodeLicense" Content="Лицензионный отдел" Click="FilterByDepartment_Click" Canvas.Left="170" Canvas.Top="180" Width="160"/>
                    <Line x:Name="lineTopToLeft" Stroke="Black"/><Line x:Name="lineTopToRight" Stroke="Black"/><Line x:Name="lineLeftToContract" Stroke="Black"/>
                    <Line x:Name="lineLeftToCommon" Stroke="Black"/><Line x:Name="lineCommonToContractLeft" Stroke="Black"/><Line x:Name="lineCommonToMarketingRight" Stroke="Black"/>
                </Canvas>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelGrayBrush}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding EmployeeCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OpenEmployeeCard_Click">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding DepartmentName}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="AddEmployee_Click">+</Button>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsEmployeeCardOpen, Converter={StaticResource BoolToVisibilityConverter}}" Background="#80000000">
            <Border Background="White" Width="850" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.DataContext><Binding Path="SelectedEmployee"/></Border.DataContext>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Карточка сотрудника" FontWeight="Bold" FontSize="16"/>
                        <Button Margin="8,0,0,0" Click="StartEditEmployee_Click">✎</Button>
                        <Button Margin="8,0,0,0" Click="DismissEmployee_Click">Уволить</Button>
                        <Button Margin="8,0,0,0" Click="CloseEmployeeCard_Click">✕</Button>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ФИО *"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        <TextBlock Grid.Row="1" Text="Телефон"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkPhone, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        <TextBlock Grid.Row="2" Text="Email"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        <TextBlock Grid.Row="3" Text="Кабинет"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EmployeeOffice, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        <TextBlock Grid.Row="4" Text="События" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding DataContext.EmployeeEvents, RelativeSource={RelativeSource AncestorType=Page}}">
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TypeName}" FontWeight="Bold"/><TextBlock Text=": "/><TextBlock Text="{Binding DateRangeDisplay}"/><Button Margin="8,0,0,0" Click="DeleteEmployeeEvent_Click" Tag="{Binding}">Удалить</Button></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox Width="120" ItemsSource="{Binding DataContext.EventTypeOptions, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding DataContext.SelectedEventType, RelativeSource={RelativeSource AncestorType=Page}}"/>
                            <DatePicker Margin="8,0,0,0" SelectedDate="{Binding DataContext.NewEventStartDate, RelativeSource={RelativeSource AncestorType=Page}}"/>
                            <DatePicker Margin="8,0,0,0" SelectedDate="{Binding DataContext.NewEventEndDate, RelativeSource={RelativeSource AncestorType=Page}}"/>
                            <Button Margin="8,0,0,0" Click="AddEmployeeEvent_Click">Добавить событие</Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Width="120" Margin="0,0,8,0" Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}" Click="SaveEmployee_Click">Сохранить</Button>
                        <Button Width="120" Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}" Click="CancelEditEmployee_Click">Отмена</Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
