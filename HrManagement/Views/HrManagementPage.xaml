<Page x:Class="HrManagement.Views.HrManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HrManagement.Views"
      xmlns:viewModel="clr-namespace:HrManagement.ViewModel"
      xmlns:converters="clr-namespace:HrManagement.Converters"
      mc:Ignorable="d">


    <Page.Resources>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#77B34B"/>
        <SolidColorBrush x:Key="HeaderGreenBrush" Color="#EAF8DF"/>
        <SolidColorBrush x:Key="CardGreenBrush" Color="#E6F5C9"/>
        <SolidColorBrush x:Key="PanelGrayBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#D0D0D0"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter"/>
        <Style x:Key="PaleCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGreenBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDismissedRecently}" Value="True">
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="FilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                    <Setter Property="BorderBrush" Value="#5C8D3B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGreenBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <Border Width="70" Height="70"
                    Background="{StaticResource AccentGreenBrush}"
                    CornerRadius="40"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="12,0">
                    <TextBlock Text="логотип"
                           FontWeight="Bold" 
                           Foreground="Black" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           />
                </Border>

                <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Height="40"
                    VerticalAlignment="Center"
                    Margin="24,0">
                    <TextBlock Text="Организационная структура"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           FontWeight="Bold"
                           Foreground="Black"/>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="18,18,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="640"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Border Background="{StaticResource PanelGrayBrush}" Padding="18" CornerRadius="2" Margin="0,0,12,0">
                <Canvas x:Name="canvasOrgChart" MinHeight="560" MinWidth="690">

                    <!-- Дороги России -->
                    <Button x:Name="nodeTop" 
                            Background="{StaticResource CardGreenBrush}" 
                            BorderBrush="#BFDFA3"
                            HorizontalAlignment="Center" 
                            Content="Дороги России" 
                            Command="{Binding FilterByDepartmentCommand}"
                            CommandParameter="{x:Null}"
                            Padding="8" 
                            Canvas.Left="300" Canvas.Top="8"/>

                    <!-- Административный департамент -->
                    <Button x:Name="nodeLeftDept" 
                            Background="{StaticResource CardGreenBrush}" 
                            BorderBrush="#BFDFA3"
                            HorizontalAlignment="Center"
                            Content="Административный департамент"
                            Command="{Binding FilterByDepartmentCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Padding="8" 
                            Canvas.Left="140" Canvas.Top="60"/>

                    <!-- Академия Умные дороги -->
                    <Button x:Name="nodeRightDept" 
                            Background="{StaticResource CardGreenBrush}" 
                            BorderBrush="#BFDFA3"
                            HorizontalAlignment="Center" 
                            Content="Академия Умные дороги" 
                            Command="{Binding FilterByDepartmentCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Padding="8" 
                            Canvas.Left="380" Canvas.Top="60" Width="180"/>

                    <!-- Договорной отдел -->
                    <Button x:Name="nodeContract" 
                            Background="{StaticResource CardGreenBrush}" 
                            BorderBrush="#BFDFA3"
                            HorizontalAlignment="Center" 
                            Content="Договорной отдел" 
                            Command="{Binding FilterByDepartmentCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Padding="8" 
                            Canvas.Left="30" Canvas.Top="120" Width="160"/>

                    <!-- Общий отдел -->
                    <Button x:Name="nodeCommon" 
                            Background="{StaticResource CardGreenBrush}" 
                            BorderBrush="#BFDFA3"
                            HorizontalAlignment="Center" 
                            Content="Общий отдел"
                            Command="{Binding FilterByDepartmentCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Padding="8" 
                            Canvas.Left="250" Canvas.Top="120" Width="180"/>

                    <!-- Управление маркетинга -->
                    <Button x:Name="nodeMarketing" 
                            Background="{StaticResource CardGreenBrush}" 
                            BorderBrush="#BFDFA3"
                            HorizontalAlignment="Center" 
                            Content="Управление маркетинга"
                            Command="{Binding FilterByDepartmentCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Padding="8" 
                            Canvas.Left="380" Canvas.Top="180" Width="180"/>

                    <!-- Лицензионный отдел -->
                    <Button x:Name="nodeLicense" 
                            Background="{StaticResource CardGreenBrush}" 
                            BorderBrush="#BFDFA3"
                            HorizontalAlignment="Center" 
                            Content="Лицензионный отдел"
                            Command="{Binding FilterByDepartmentCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Content}"
                            Padding="8" 
                            Canvas.Left="170" Canvas.Top="180" Width="160"/>

                    <!-- Линии -->
                    <!-- Линии (лучше ниже по ZIndex, чтобы не перекрывали карточки) -->
                    <Line x:Name="lineTopToLeft" Stroke="Black" StrokeThickness="1.4" Canvas.ZIndex="0"/>
                    <Line x:Name="lineTopToRight" Stroke="Black" StrokeThickness="1.4" Canvas.ZIndex="0"/>

                    <Line x:Name="lineLeftToContract" Stroke="Black" StrokeThickness="1.2" Canvas.ZIndex="0"/>

                    <!-- НОВАЯ линия: Адм. департамент -> Общий отдел -->
                    <Line x:Name="lineLeftToCommon" Stroke="Black" StrokeThickness="1.2" Canvas.ZIndex="0"/>

                    <Line x:Name="lineRightToCommon" Stroke="Black" StrokeThickness="1.2" Canvas.ZIndex="0"/>

                    <!-- Общий отдел -> нижние блоки -->
                    <Line x:Name="lineCommonToContractLeft" Stroke="Black" StrokeThickness="1.2" Canvas.ZIndex="0"/>
                    <Line x:Name="lineCommonToMarketingRight" Stroke="Black" StrokeThickness="1.2" Canvas.ZIndex="0"/>
                </Canvas>
            </Border>

            <!-- Правая панель -->
            <Border Grid.Column="1" Background="{StaticResource PanelGrayBrush}" Padding="18" CornerRadius="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <!-- карточка -->
                        <ItemsControl ItemsSource="{Binding EmployeeCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CardButtonStyle}"
                                            Command="{Binding DataContext.OpenEmployeeCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Border Style="{StaticResource PaleCard}">
                                            <StackPanel>
                                                <TextBlock FontSize="12" Foreground="Gray">
                                                    <Run Text="{Binding DepartmentName}" />
                                                    <Run Text=" — " />
                                                    <Run Text="{Binding PositionName}" />
                                                </TextBlock>
                                                <TextBlock FontWeight="Bold" FontSize="14" Margin="0,6,0,0" Text="{Binding FullName}" />
                                                <TextBlock Margin="0,6,0,0">
                                                    <Run Text="{Binding WorkPhone}" />
                                                    <Run Text="   " />
                                                    <Run Text="{Binding Email}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,6,0,0" Foreground="Gray" Text="{Binding EmployeeOffice}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Кнопка добавления -->
                    <Button Grid.Row="1" 
                            Width="48" Height="48" 
                            Background="{StaticResource CardGreenBrush}" 
                            BorderBrush="#BFDFA3"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom" 
                            Margin="0,0,12,12" 
                            FontSize="20" 
                            FontWeight="Bold"
                            Command="{Binding AddEmployeeCommand}">
                        +
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Модальное окно карточки сотрудника -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Visibility="{Binding IsEmployeeCardOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000"
              Panel.ZIndex="10">
            <Border Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Width="850"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.DataContext>
                    <Binding Path="SelectedEmployee"/>
                </Border.DataContext>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Карточка сотрудника"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Margin="0,0,8,0"
                                Background="{StaticResource CardGreenBrush}"
                                BorderBrush="#BFDFA3"
                                FontSize="16"
                                Content="✎"
                                ToolTip="Редактировать"
                                Command="{Binding DataContext.StartEditEmployeeCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        <Button Grid.Column="2"
                                Padding="10,0"
                                Height="32"
                                Margin="0,0,8,0"
                                Background="#E57373"
                                Foreground="White"
                                BorderBrush="#C55A5A"
                                Content="Уволить"
                                ToolTip="Уволить сотрудника"
                                Command="{Binding DataContext.DismissEmployeeCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        <Button Grid.Column="3"
                                Width="32"
                                Height="32"
                                Background="#F2F2F2"
                                BorderBrush="#C7C7C7"
                                FontSize="14"
                                Content="✕"
                                ToolTip="Закрыть"
                                Command="{Binding DataContext.CloseEmployeeCardCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding DataContext.ValidationErrors, RelativeSource={RelativeSource AncestorType=Page}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#C62828"
                                                   Text="{Binding}"
                                                   Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="ФИО *" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanNegationConverter}}"/>

                                    <TextBlock Text="Мобильный телефон" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding PersonalPhone, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanNegationConverter}}"/>

                                    <TextBlock Text="День рождения" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <DatePicker Grid.Row="2" Grid.Column="1"
                                                SelectedDate="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"/>

                                    <TextBlock Text="Структурное подразделение *" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Page}}"
                                              DisplayMemberPath="NameDepartment"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding IdEmployeeDepartment, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"/>

                                    <TextBlock Text="Должность *" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.Positions, RelativeSource={RelativeSource AncestorType=Page}}"
                                              DisplayMemberPath="NamePosition"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding IdPosition, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"/>

                                    <TextBlock Text="Непосредственный руководитель" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.DepartmentEmployees, RelativeSource={RelativeSource AncestorType=Page}}"
                                              DisplayMemberPath="FullName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding DirectSupervisor, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"/>

                                    <TextBlock Text="Помощник" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.DepartmentEmployees, RelativeSource={RelativeSource AncestorType=Page}}"
                                              DisplayMemberPath="FullName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding AssistantEmployee, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"/>

                                    <TextBlock Text="Рабочий телефон *" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <TextBox Grid.Row="7" Grid.Column="1"
                                             Text="{Binding WorkPhone, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanNegationConverter}}"/>

                                    <TextBlock Text="Электронная почта *" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <TextBox Grid.Row="8" Grid.Column="1"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanNegationConverter}}"/>

                                    <TextBlock Text="Кабинет *" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                    <TextBox Grid.Row="9" Grid.Column="1"
                                             Text="{Binding EmployeeOffice, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10"
                                             IsReadOnly="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanNegationConverter}}"/>

                                    <TextBlock Text="Прочая информация" Grid.Row="10" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,12,8"/>
                                    <TextBox Grid.Row="10" Grid.Column="1"
                                             Text="{Binding Other, UpdateSourceTrigger=PropertyChanged}"
                                             Height="80"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsReadOnly="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanNegationConverter}}"/>
                                </Grid>

                                <Border Grid.Column="1"
                                        Background="#FAFAFA"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="События сотрудника"
                                                   FontWeight="Bold"
                                                   FontSize="14"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                                            <ToggleButton Style="{StaticResource FilterToggleStyle}"
                                                          Content="Прошедшие"
                                                          IsChecked="{Binding DataContext.ShowPastEvents, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                            <ToggleButton Style="{StaticResource FilterToggleStyle}"
                                                          Content="Текущие"
                                                          IsChecked="{Binding DataContext.ShowCurrentEvents, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                            <ToggleButton Style="{StaticResource FilterToggleStyle}"
                                                          Content="Будущие"
                                                          IsChecked="{Binding DataContext.ShowFutureEvents, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding DataContext.EmployeeEventsView, RelativeSource={RelativeSource AncestorType=Page}}">
                                            <ItemsControl.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,6,0,4"/>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ItemsControl.GroupStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White"
                                                            BorderBrush="{StaticResource SoftBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="{Binding DateRangeDisplay}"/>
                                                                <TextBlock Text="{Binding Reason, StringFormat=Обоснование: {0}}"
                                                                           Foreground="Gray"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Content="Удалить"
                                                                    Margin="8,0,0,0"
                                                                    Padding="8,2"
                                                                    IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    Command="{Binding DataContext.DeleteEmployeeEventCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Separator Margin="0,8,0,8"/>

                                        <TextBlock Text="Добавить событие"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>

                                        <StackPanel IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}}">
                                            <TextBlock Text="Тип события *" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding DataContext.EventTypeOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      SelectedItem="{Binding DataContext.SelectedEventType, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      Margin="0,0,0,8"/>

                                            <TextBlock Text="Дата начала *" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding DataContext.NewEventStartDate, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        Margin="0,0,0,8"/>

                                            <TextBlock Text="Дата окончания *" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding DataContext.NewEventEndDate, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        Margin="0,0,0,8"/>

                                            <TextBlock Text="Обоснование" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding DataContext.NewEventReason, RelativeSource={RelativeSource AncestorType=Page}}"
                                                     Height="60"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"/>

                                            <ItemsControl ItemsSource="{Binding DataContext.EventValidationErrors, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Foreground="#C62828"
                                                                   Text="{Binding}"
                                                                   Margin="0,0,0,4"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="Добавить"
                                                    Width="140"
                                                    Margin="0,8,0,0"
                                                    Background="{StaticResource AccentGreenBrush}"
                                                    Foreground="White"
                                                    BorderBrush="#5C8D3B"
                                                    Command="{Binding DataContext.AddEmployeeEventCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Content="Сохранить"
                                Width="120"
                                Margin="0,0,8,0"
                                Background="{StaticResource AccentGreenBrush}"
                                Foreground="White"
                                BorderBrush="#5C8D3B"
                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding DataContext.SaveEmployeeCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        <Button Content="Отмена"
                                Width="120"
                                Background="#F2F2F2"
                                BorderBrush="#C7C7C7"
                                Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding DataContext.CancelEditEmployeeCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
